# Q6 - Sites les mieux notés (note moyenne >= seuil).
# Paramètre : ?noteMin (xsd:decimal)
# Notions : sous-requête avec agrégat AVG, filtre sur le résultat agrégé
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo:  <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX tt:   <http://example.org/tourisme-tunisie#>

SELECT ?site ?nom ?noteMoyenne ?nbAvis
WHERE {
  {
    SELECT ?site (AVG(?n) AS ?noteMoyenne) (COUNT(?avis) AS ?nbAvis)
    WHERE {
      ?avis a tt:Avis ;
            tt:concerne ?site ;
            tt:note ?n .
    }
    GROUP BY ?site
  }
  ?site rdfs:label ?nom .
  FILTER(?noteMoyenne >= ?noteMin)
}
ORDER BY DESC(?noteMoyenne) DESC(?nbAvis)
