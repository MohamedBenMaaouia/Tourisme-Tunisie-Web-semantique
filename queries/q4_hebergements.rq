# Q4 - Hébergements filtrés par région, étoiles minimales et prix maximal.
# Paramètres : ?prixMax (obligatoire), ?etoilesMin, ?regionNom (optionnels)
# Notions : OPTIONAL + BOUND, filtres combinés, IN, tri
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo:  <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX tt:   <http://example.org/tourisme-tunisie#>

SELECT ?hebergement ?nom ?type ?ville ?region ?etoiles ?prixNuit
WHERE {
  ?hebergement a tt:Hebergement ;
               a ?type ;
               rdfs:label ?nom ;
               tt:prixNuit ?prixNuit ;
               tt:situeDansVille ?v .
  ?v rdfs:label ?ville ;
     tt:villeDeRegion/rdfs:label ?region .
  FILTER(?type IN (tt:Hotel, tt:MaisonDHotes))
  OPTIONAL { ?hebergement tt:nombreEtoiles ?etoiles }
  FILTER(?prixNuit <= ?prixMax)
  FILTER(!BOUND(?etoilesMin) || (BOUND(?etoiles) && ?etoiles >= ?etoilesMin))
  FILTER(!BOUND(?regionNom) || LCASE(STR(?region)) = LCASE(STR(?regionNom)))
}
ORDER BY ?prixNuit
