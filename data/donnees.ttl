tt:V_Sousse      rdfs:label "Sousse"@fr         ; tt:villeDeRegion tt:R_Sousse .
tt:V_ElJem       rdfs:label "El Jem"@fr         ; tt:villeDeRegion tt:R_Mahdia .
tt:V_Mahdia      rdfs:label "Mahdia"@fr         ; tt:villeDeRegion tt:R_Mahdia .
tt:V_Kairouan    rdfs:label "Kairouan"@fr       ; tt:villeDeRegion tt:R_Kairouan .
